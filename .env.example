# =============================================================================
# MdjeBot Builder — Environment Configuration
# Created by the installer (`mdjebot` → Install). Keep this file private (mode 600).
#
# The builder is a Telegram bot where your customers buy a monthly plan, create a
# bot in @BotFather and send you its token; the builder then builds and runs their
# own MdjeBot (own container, database, Redis namespace and host port).
# =============================================================================


# -----------------------------------------------------------------------------
# Telegram API — the installer fills in Telegram's public credentials, so nothing is asked.
# To use your own app (https://my.telegram.org/apps): `mdjebot` → 12 → "Change API_ID / API_HASH".
# Shared by every customer bot.
# -----------------------------------------------------------------------------
API_ID=
API_HASH=


# -----------------------------------------------------------------------------
# Bot Builder
# -----------------------------------------------------------------------------
# Token of a NEW bot from @BotFather: this is the bot your customers talk to
BUILDER_BOT_TOKEN=
# Comma-separated numeric Telegram IDs of the builder's administrators (see @userinfobot)
BUILDER_ADMIN_ID=
# Fernet key that encrypts customers' bot tokens in the builder database.
# Generated by the installer — back it up: without it stored tokens are unreadable.
BUILDER_SECRET_KEY=

# Host port range handed out to customer bots (one port each, maps to their FastAPI)
# BUILDER_PORT_START=7000
# BUILDER_PORT_END=7999
# Image used for customer bots (default: same image/tag as the builder)
# BUILDER_TENANT_IMAGE=ghcr.io/mdjes/mdjebot:latest
# LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# MariaDB container (appended by the installer)
# The builder uses the root account to create one database + user per customer bot.
# -----------------------------------------------------------------------------
# MARIADB_ROOT_PASSWORD=
# MARIADB_DATABASE=mdjebot
# MARIADB_USER=mdjebot
# MARIADB_PASSWORD=


# -----------------------------------------------------------------------------
# Docker deploy paths (set by the installer)
# -----------------------------------------------------------------------------
# MDJEBOT_CONFIG_DIR=/opt/mdjebot
# Image tag: main → latest, other branches → branch name (e.g. dev)
# MDJEBOT_IMAGE_TAG=latest
